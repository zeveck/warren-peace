{ "segment": "c1-rts1", "note": "The first army battle start to finish on the pad: the preview, every tutorial tip in its pad text, cursor orders, select-all by Square twice, pause, speed.", "steps": [
  {"until": "s.screen===\"explore\" && !s.busy", "timeout": 20000},
  {"pad": "l3"},
  {"padUse": [30, 10], "note": "the Lookout Stone"},
  {"until": "s.dialog.open", "timeout": 20000},
  {"padTalkthrough": true, "choose": [0]},
  {"until": "s.screen===\"rts-preview\"", "timeout": 8000},
  {"wait": 300},
  {"expect": "s.hints.some(h => h.startsWith('[cross] pick/unpick') && h.includes('[triangle] start') && !h.includes('[square]'))"},
  {"pad": "triangle", "note": "start the battle"},
  {"until": "r && r.tip && r.tip.startsWith('Your army waits')", "timeout": 8000},
  {"expect": "r.tip.includes('R1') && r.tip.includes('Square twice') && r.cursor === 'home'"},
  {"expect": "s.hints.some(h => h.startsWith('[l1r1] or [square] pick squads'))"},
  {"pad": "r1", "note": "one squad"},
  {"expect": "r.selected.length === 1"},
  {"pad": "r1"}, {"expect": "r.selected.length === 1"},
  {"chord": ["l2", "r1"], "note": "add the next"}, {"expect": "r.selected.length === 2"},
  {"pad": "circle", "note": "clear"}, {"expect": "r.selected.length === 0"},
  {"padOrder": "ridge", "all": true, "note": "everyone to the ridge"},
  {"expect": "r.started && r.selected.length === r.list.length"},
  {"until": "r && r.tip && r.tip.startsWith('The right stick')", "timeout": 30000},
  {"rstick": [1, 0], "ms": 400, "note": "look around"},
  {"chord": ["r2", "r1"], "note": "speed 2x"}, {"expect": "r.speed === 2 && s.toast === 'Speed 2x'"},
  {"chord": ["r2", "r1"]}, {"expect": "r.speed === 1"},
  {"chord": ["r2", "l1"], "note": "home"}, {"expect": "r.cursor === 'home'"},
  {"pad": "create"}, {"expect": "r.paused"}, {"pad": "create"}, {"expect": "!r.paused"},
  {"until": "r && r.tip && r.tip.startsWith('The triangle')", "timeout": 120000},
  {"expect": "r.tipWait && r.tip.includes('Create pauses') && s.hints.some(h => h === '[cross] close')"},
  {"wait": 300},
  {"pad": "cross", "note": "read the tip"},
  {"expect": "!r.tipWait"},
  {"until": "r.nodes.find(n => n.id === 'ridge').owner === 'player'", "timeout": 60000},
  {"padOrder": "clover", "all": true, "note": "everyone on the clover"},
  {"until": "r && r.tip && r.tip.startsWith('Raiders come')", "timeout": 120000},
  {"wait": 300},
  {"pad": "cross", "note": "read the tip"},
  {"until": "r.nodes.find(n => n.id === 'clover').owner === 'player'", "timeout": 90000},
  {"padOrder": "burrow", "all": true},
  {"until": "r.nodes.find(n => n.id === 'burrow').owner === 'player'", "timeout": 120000},
  {"padOrder": "mouth", "all": true, "note": "the warren mouth: take it and hold it"},
  {"until": "!r || r.result === 'win'", "timeout": 200000},
  {"until": "!r", "timeout": 20000},
  {"padTalkthrough": true},
  {"done": true}
]}
