{ "segment": "c0-surface", "note": "Exploration on the pad only: stick hops (diagonals and straight), Cross talks, choices, Square nibbles, Triangle camp, L1/R1 tabs, Create/View map, Circle closes.", "steps": [
  {"until": "s.screen === 'explore' && !s.busy", "timeout": 20000},
  {"pad": "l3", "note": "the pad takes over"},
  {"expect": "s.device === 'pad' && s.hints.length === 0"},
  {"stick": [0, -1], "ms": 500, "note": "straight up the screen: the zig-zag"},
  {"until": "!s.moving", "timeout": 3000},
  {"pad": "square", "note": "nibble"}, {"wait": 1500}, {"padTalkthrough": true},
  {"pad": "triangle", "note": "camp"}, {"until": "s.screen === 'camp'", "timeout": 3000},
  {"expect": "s.hints.some(h => h.startsWith('[l1r1] tabs [cross] choose [circle] back [triangle] close'))"},
  {"pad": "r1"}, {"pad": "r1"}, {"pad": "l1"},
  {"pad": "circle"}, {"until": "s.screen === 'explore'", "timeout": 3000},
  {"pad": "create", "note": "camp, on the Map tab"}, {"until": "s.screen === 'camp'", "timeout": 3000},
  {"pad": "triangle"}, {"until": "s.screen === 'explore'", "timeout": 3000},
  {"padTalk": "tansy", "note": "Tansy"}, {"padTalkthrough": true, "choose": [0]},
  {"until": "!s.busy", "timeout": 20000},
  {"padTalk": "pip", "note": "Pip asks"}, {"padTalkthrough": true, "choose": [1]},
  {"expect": "s.quest.includes('press Cross')", "note": "the {act} token reads Cross on the pad"},
  {"padUse": [9, 26], "note": "the hollow log"}, {"until": "s.dialog.open", "timeout": 20000}, {"padTalkthrough": true},
  {"padTalk": "pip", "note": "button back"}, {"padTalkthrough": true},
  {"wait": 600}, {"padTalkthrough": true, "note": "tremor"},
  {"padWalk": [18, 20]}, {"padWalk": [18, 19]}, {"padWalk": [18, 18], "note": "the warren mouth"},
  {"padTalkthrough": true},
  {"until": "s.map === 'c0-warren'", "timeout": 20000}, {"padTalkthrough": true},
  {"expect": "s.device === 'pad'"},
  {"done": true}
]}
