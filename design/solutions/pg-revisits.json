{ "segment": "pg-revisits", "steps": [
  {"until": "s.screen===\"explore\" && !s.busy", "timeout": 20000},
  {"click": [6, 24], "note": "the sunset Lookout Stone (after g_won it is usable)"},
  {"until": "s.dialog.open", "timeout": 15000},
  {"talkthrough": true, "note": "first time: the narration and Burdock's line"},
  {"until": "s.screen===\"revisits\"", "timeout": 8000},
  {"until": "window.__game.buttons().some(b => b.label === 'Sorrel Down: not yet')", "timeout": 3000},
  {"button": "Sorrel Down", "note": "1: Sorrel Down"},
  {"until": "s.screen===\"rts-preview\"", "timeout": 8000},
  {"button": "Start the battle"},
  {"until": "r && r.revisit && !r.started && r.prompt === null", "timeout": 8000, "note": "no tutorial tips in a revisit"},
  {"press": "KeyB", "note": "the rush: everyone to their warren mouth"},
  {"press": "KeyK"},
  {"until": "r && r.result === 'win'", "timeout": 120000},
  {"until": "r && r.rev && r.rev.isNew && /New best!/.test(r.bannerSub)", "timeout": 3000},
  {"until": "s.screen===\"revisits\"", "timeout": 15000, "note": "back at the menu, no .won story"},
  {"until": "window.__game.buttons().some(b => b.label.startsWith('Sorrel Down: best '))", "timeout": 3000},
  {"button": "Silverdown", "note": "2: Silverdown, then retreat"},
  {"until": "s.screen===\"rts-preview\"", "timeout": 8000},
  {"button": "Start the battle"},
  {"until": "r && r.revisit", "timeout": 8000},
  {"press": "Escape"},
  {"until": "s.screen===\"pause\"", "timeout": 5000},
  {"button": "Retreat"},
  {"until": "r && r.result === 'lose'", "timeout": 5000},
  {"until": "s.screen===\"dialog\"", "timeout": 15000, "note": "one line, then the menu again"},
  {"talkthrough": true},
  {"until": "s.screen===\"revisits\"", "timeout": 8000},
  {"until": "window.__game.buttons().some(b => b.label === 'Silverdown: not yet')", "timeout": 3000, "note": "a retreat records no time"},
  {"button": "Flintcomb", "note": "4: Flintcomb, the army autopilot"},
  {"army": "auto"},
  {"until": "s.screen===\"revisits\"", "timeout": 20000},
  {"until": "window.__game.buttons().some(b => b.label.startsWith('Flintcomb: best '))", "timeout": 3000},
  {"press": "Escape", "note": "Esc leaves the menu"},
  {"until": "s.screen===\"explore\" && !s.busy", "timeout": 8000},
  {"until": "s.map === 'c5-sunset' && s.chapter === 5 && s.quest.startsWith('Peace on the Downs')", "timeout": 3000, "note": "no .won warp, chapter or quest change"},
  {"until": "(a => a && a.s.armyBest['c1-rts1'] && a.s.armyBest['c4-rts4'] && !a.s.armyBest['c2-rts2'] && Object.keys(a.s.losses).length === 0)(JSON.parse(localStorage.getItem('warren-peace-save')).auto)", "timeout": 5000, "note": "autosaved: two best times, no losses counted"},
  {"done": true}
]}
